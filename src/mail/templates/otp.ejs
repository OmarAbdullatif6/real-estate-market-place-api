<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Verification Code</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 20px;">
  <div style="max-width: 500px; margin: auto; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;">
    <h2>Hello <%= name %>,</h2>
    <p>Use the following 6-digit code to verify your account:</p>
    
    <div style="font-size: 32px; font-weight: bold; letter-spacing: 6px; text-align: center; margin: 24px 0; color: #2563eb; background: #f8fafc; padding: 12px; border-radius: 6px;">
      <%= otp %>
    </div>

    <p>This code will expire in <strong>10 minutes</strong>.</p>
    <p style="color: #64748b; font-size: 13px;">If you did not request this, please ignore this email.</p>
  </div>
</body>
</html>